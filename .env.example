# Copy to .env and fill in your Azure Claude values. Never commit .env.
# The endpoint should be the full Anthropic Messages URL, for example:
# https://YOUR_RESOURCE.services.ai.azure.com/anthropic/v1/messages
AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_MODEL=
AZURE_CLAUDE_API_VERSION=2023-06-01

# api-key is the usual Azure header. Use x-api-key or bearer if your gateway requires it.
AZURE_CLAUDE_AUTH_STYLE=api-key
